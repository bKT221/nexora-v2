generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// NEXORA V2 — Complete Database Schema
// ============================================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  avatar        String?
  password      String?
  role          String   @default("user") // user, admin, mentor
  profile       String   @default("etudiant") // etudiant, entrepreneur
  country       String?
  phone         String?
  xp            Int      @default(0)
  level         Int      @default(1)
  streak        Int      @default(0)
  nexoraCoins   Int      @default(0)
  subscription  String   @default("free") // free, gold, exam_pack
  kycVerified   Boolean  @default(false)
  lowDataMode   Boolean  @default(false)
  lastActiveAt  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enrollments   Enrollment[]
  quizResults   QuizResult[]
  posts         SocialPost[]
  comments      Comment[]
  likes         Like[]
  purchases     Purchase[]
  products      Product[]
  mentorships   Mentorship[] @relation("Mentee")
  mentorings    Mentorship[] @relation("Mentor")
  notifications Notification[]
  chatMessages  ChatMessage[]
  earnings      Earning[]
  groupMembers  GroupMember[]
  courses       Course[]    @relation("CourseAuthor")
}

model Course {
  id          String   @id @default(cuid())
  title       String
  description String?
  subject     String
  level       String   // BFEM, BAC, BTS, BT, Licence
  coverUrl    String?
  fileUrl     String?
  fileSize    Int?
  authorId    String
  price       Int      @default(0)
  rating      Float    @default(0)
  enrollCount Int      @default(0)
  isFree      Boolean  @default(true)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments Enrollment[]
  quizzes     Quiz[]
  revisions   RevisionSheet[]
  purchases   Purchase[]
  author      User      @relation(fields: [authorId], references: [id], name: "CourseAuthor")
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  progress  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
  course    Course   @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
}

model Quiz {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  type        String   @default("practice") // practice, duel, exam
  duration    Int      @default(600) // seconds
  questionCount Int
  createdAt   DateTime @default(now())

  course      Course      @relation(fields: [courseId], references: [id])
  results     QuizResult[]
}

model QuizResult {
  id          String   @id @default(cuid())
  userId      String
  quizId      String
  score       Int
  xpEarned    Int      @default(0)
  completedAt DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
  quiz        Quiz     @relation(fields: [quizId], references: [id])
}

model RevisionSheet {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  content     String
  generatedBy String   @default("ai")
  createdAt   DateTime @default(now())

  course      Course   @relation(fields: [courseId], references: [id])
}

model SocialPost {
  id        String   @id @default(cuid())
  authorId  String
  content   String
  imageUrl  String?
  likesCount Int     @default(0)
  commentsCount Int  @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author    User      @relation(fields: [authorId], references: [id])
  comments  Comment[]
  likes     Like[]
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  post      SocialPost @relation(fields: [postId], references: [id])
  author    User       @relation(fields: [authorId], references: [id])
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post      SocialPost @relation(fields: [postId], references: [id])
  user      User       @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String
  memberCount Int      @default(0)
  createdAt   DateTime @default(now())

  members     GroupMember[]
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  role      String   @default("member") // admin, member
  joinedAt  DateTime @default(now())

  group     Group    @relation(fields: [groupId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
}

model Mentorship {
  id          String   @id @default(cuid())
  mentorId    String
  menteeId    String
  status      String   @default("pending") // pending, active, completed
  nextSession DateTime?
  createdAt   DateTime @default(now())

  mentor      User     @relation("Mentor", fields: [mentorId], references: [id])
  mentee      User     @relation("Mentee", fields: [menteeId], references: [id])
}

model Product {
  id          String   @id @default(cuid())
  sellerId    String
  title       String
  description String?
  price       Int
  category    String   // course_pdf, video, freelance_design, freelance_dev, freelance_writing, correction
  rating      Float    @default(0)
  salesCount  Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  seller      User      @relation(fields: [sellerId], references: [id])
  purchases   Purchase[]
}

model Purchase {
  id          String   @id @default(cuid())
  buyerId     String
  productId   String
  courseId    String?
  amount      Int
  currency    String   @default("FCFA")
  paymentMethod String? // wave, orange, mtn, moov
  status      String   @default("completed") // pending, completed, refunded
  createdAt   DateTime @default(now())

  buyer       User     @relation(fields: [buyerId], references: [id])
  product     Product?  @relation(fields: [productId], references: [id])
  course      Course?   @relation(fields: [courseId], references: [id])
}

model Earning {
  id          String   @id @default(cuid())
  userId      String
  amount      Int
  source      String   // sale, commission, referral
  status      String   @default("available") // available, withdrawn, pending
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
}

model ChatMessage {
  id          String   @id @default(cuid())
  userId      String
  role        String   // user, assistant
  content     String
  model       String?  // cloud, local_slm
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   // xp, course, social, payment, system
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  eventType   String   // page_view, quiz_complete, purchase, ai_query
  userId      String?
  metadata    String?  // JSON string
  country     String?
  createdAt   DateTime @default(now())
}
